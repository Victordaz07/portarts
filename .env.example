# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# On Vercel: add the Neon integration (Storage → Marketplace → Neon) and it sets
# this automatically. Locally, paste your Neon connection string.
DATABASE_URL=

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
# Generate a secret: `npx auth secret`  (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app — https://github.com/settings/developers
# Authorization callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of emails allowed into the /admin panel.
ADMIN_EMAILS=you@example.com

# ─── Storage (Vercel Blob) ───────────────────────────────────────────────────
# On Vercel: add a Blob store (Storage → Blob) and it sets this automatically.
# Locally, copy the token from the Blob store settings.
BLOB_READ_WRITE_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────────────
# GitHub API token for the public repos feed (raises rate limit from 60/hr).
# Create at https://github.com/settings/tokens with scope: public_repo (read-only)
GITHUB_TOKEN=

# Public canonical site URL (used for analytics origin allow-list & metadata).
NEXT_PUBLIC_SITE_URL=

# Public URL of your resume PDF (e.g. a Vercel Blob URL). Leave empty to hide the button.
NEXT_PUBLIC_RESUME_URL=
